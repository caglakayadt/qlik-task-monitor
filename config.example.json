{
  "EnvironmentName": "PROD",
  "QrsHost": "qliksense.company.local",
  "QrsPort": 4242,
  "Auth": {
    "Mode": "CertStore",
    "CertStoreLocation": "CurrentUser",
    "CertSubject": "CN=QlikClient",
    "PfxPath": "C:\\QlikTaskMonitor\\certs\\client.pfx",
    "PfxPassword": "",
    "UserDirectory": "INTERNAL",
    "UserId": "sa_repository"
  },
  "SkipServerCertValidation": true,

  "TeamsWebhookUrl": "https://...buraya Teams Workflow webhook URL'si...",

  "PollIntervalSeconds": 60,
  "FailStatuses": [6, 8, 11],
  "NotifyOnRecovery": true,
  "AlertExistingFailuresOnStart": false,
  "ConnectionFailureThreshold": 3,
  "MaxCardsPerCycle": 5,

  "IncludeExternalProgramTasks": true,
  "TaskNameInclude": "",
  "TaskNameExclude": "",

  "QmcBaseUrl": "https://qliksense.company.local/qmc",
  "HubBaseUrl": "https://qliksense.company.local",

  "StateFile": "state.json",
  "LogFile": "logs\\monitor.log"
}
